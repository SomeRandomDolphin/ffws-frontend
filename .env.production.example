# Port yang diekspos oleh container frontend.
FFWS_PORT=3000
FFWS_BIND_ADDRESS=127.0.0.1
LARAVEL_PORT=8080
MONITORING_API_PORT=8001
NEXT_PUBLIC_MONITORING_API_URL=/monitoring-api

# Generated automatically by scripts/initialize-stack.ps1. Never commit real values.
ARCHIVE_PASSWORD=replace-with-random-hex-password
ARCHIVE_ROOT_PASSWORD=replace-with-another-random-hex-password

# Leave empty until an upstream Welang provider implements the documented contract.
WELANG_API_URL=
WELANG_API_TOKEN=
# Directory or file inside the monitoring container (CSV/XLSX).
WELANG_IMPORT_PATH=/app/imports/history
PREDICTIONS_ENABLED=false
TELEGRAM_ENABLED=false

